# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=redesigned_iot_database

# JWT Secret
JWT_SECRET=HelloMyNameIsZim

# Server Port
PORT=3001

# ============================================
# MQTT Configuration - IMPORTANT!
# ============================================
# MQTT broker URL - MUST use mqtt:// or mqtts:// protocol
# Examples:
#   - Unencrypted: mqtt://192.168.88.221:1883
#   - Encrypted (TLS): mqtts://192.168.88.221:8883
#   - Public broker: mqtt://broker.hivemq.com:1883

# ⚠️ WRONG: https://bdtmp.ultra-x.jp/iotbrokerv1_backend (This is HTTP, not MQTT!)
# ✅ CORRECT: Use one of these formats:

# Option 1: Local MQTT broker (unencrypted)
MQTT_HOST=mqtt://192.168.88.221:1883

# Option 2: Local MQTT broker (encrypted with TLS)
# MQTT_HOST=mqtts://192.168.88.221:8883

# Option 3: If you have a domain with MQTT broker
# MQTT_HOST=mqtt://bdtmp.ultra-x.jp:1883
# or
# MQTT_HOST=mqtts://bdtmp.ultra-x.jp:8883

MQTT_USERNAME=admin
MQTT_PASSWORD=StrongPassword123

# TLS Certificate Paths (only needed for mqtts://)
MQTT_CA_CERT_PATH=./src/mqtt/Connection/broker.crt
MQTT_REJECT_UNAUTHORIZED=false
MQTT_TLS_VERSION=TLSv1.2
MQTT_CLIENT_CERT_PATH=
MQTT_CLIENT_KEY_PATH=

# ============================================
# Spatial Control Configuration
# ============================================
SPATIAL_CONTROL_ENABLED=true
CONTROL_FREQUENCY=30000
TEMPERATURE_TOLERANCE=0.5

# ============================================
# Sensor Configuration
# ============================================
SIMULATE_SENSOR=false
USE_REAL_SENSORS=true
